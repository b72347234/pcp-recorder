# PCP 期權盤口常駐錄製 (%i = gate | okx | bybit | binance | umx | derive)
# 每間所一個進程、各寫自己的每日 CSV; 單間掛掉不影響其他間。
#
# 這是樣板: @PROJECT@ / @USER@ 由 install.sh 換成實際路徑與使用者後裝到 /etc/systemd/system/。
# 不要直接編輯 /etc 那份, 改這裡再重跑 install.sh。
#
# binary 用 bin/recorder-current 這個 symlink。install.sh 每次編譯都會複製成新檔
# (bin/recorder-<時間>) 再把 symlink 指過去, 所以絕對不會蓋掉正在跑的 binary
# (2026-11-24 教訓: cargo run 蓋掉跑著的 binary, 錄製直接死掉)。
[Unit]
Description=PCP options recorder (%i)
After=network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PROJECT@
ExecStart=@PROJECT@/bin/recorder-current --only %i --strikes 5 --expiries 3 --forever --refresh-mins 10 --output-dir @PROJECT@/data
# 需要 proxy 的機器 (HTTPS_PROXY / SSL_CERT_FILE) 把設定寫在 recorder.env; 沒有這個檔也沒關係。
EnvironmentFile=-@PROJECT@/recorder.env
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
StandardOutput=append:@PROJECT@/data/service-%i.log
StandardError=inherit
StandardInput=null

[Install]
WantedBy=multi-user.target
